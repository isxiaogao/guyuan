/* ====== Vant 主题色覆盖 ====== */
page {
  --van-primary-color: #b7472a;
  --van-primary-color-dark: #9a3d23;
  --van-primary-color-active: #8a351f;
  --van-border-color: #eeece8;
  --van-cell-background: #fff;
  --van-field-input-color: #2c2c2c;
  --van-field-label-width: 5.2em;
  --van-checkbox-checked-icon-color: #b7472a;
  --checkbox-size: 36rpx;
  --checkbox-label-color: #2c2c2c;
  --van-uploader-icon-color: #d4cfc8;
  background-color: #fafaf8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #2c2c2c;
  box-sizing: border-box;
  overflow-y: auto;
  height: 100%;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}

.container {
  padding: 0 24rpx;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ====== 轮播图 ====== */
.banner-swiper {
  width: 100%;
  height: 460rpx;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-image {
  width: 100%;
  height: 100%;
}
.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
}
.banner-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ====== 通用区块 ====== */
.section {
  padding: 40rpx 24rpx 0;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 28rpx;
}
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}
.section-more {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 1rpx;
}

/* ====== 分类 ====== */
.category-scroll {
  width: 100%;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.category-list {
  display: inline-flex;
  gap: 0;
}
.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 136rpx;
  padding: 0 12rpx;
}
.category-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: #f2ede8;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
.category-icon {
  width: 52rpx;
  height: 52rpx;
}
.category-name {
  font-size: 24rpx;
  color: #555;
  text-align: center;
  font-weight: 500;
}


/* ====== 底部 ====== */
.footer {
  padding: 80rpx 0 48rpx;
  text-align: center;
}
.footer-brand {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #b7472a;
  margin-bottom: 10rpx;
  padding: 20rpx;
  letter-spacing: 2rpx;
}
.footer-text {
  font-size: 22rpx;
  color: #b0b0b0;
  letter-spacing: 1rpx;
}

/* ====== 管理悬浮按钮 ====== */
.float-buttons {
  position: fixed;
  bottom: 140rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  z-index: 100;
}
.float-btn {
  width: 92rpx;
  height: 92rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #eeece8;
}
.float-btn-main {
  background: #b7472a;
  box-shadow: 0 8rpx 24rpx rgba(183, 71, 42, 0.3);
  border-color: transparent;
}
.float-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  color: #b7472a;
  letter-spacing: 1rpx;
}
.float-btn-main .float-btn-text {
  color: #fff;
  font-size: 44rpx;
  margin-top: -4rpx;
}
