.page {
  background: #fafaf8;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 头部 */
.header {
  background: linear-gradient(160deg, #b7472a 0%, #9a3a22 100%);
  padding: 60rpx 0 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.header::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 50%;
}
.header::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -15%;
  width: 300rpx;
  height: 300rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 50%;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 10rpx;
  margin: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #eeece8;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c2c2c;
  margin-bottom: 20rpx;
  display: block;
}

.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 联系 */
.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 26rpx;
  color: #999;
  min-width: 120rpx;
}

.contact-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.contact-hint {
  font-size: 22rpx;
  color: #b7472a;
}

/* 赞赏 */
.reward-box {
  background: #f5f2ee;
  border-radius: 10rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reward-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.reward-text {
  font-size: 28rpx;
  color: #b7472a;
  font-weight: 600;
}

/* 工作室地址 */
.tech-item {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tech-item:last-child {
  border-bottom: none;
}

.tech-label {
  font-size: 26rpx;
  color: #999;
  min-width: 120rpx;
}

.tech-value {
  font-size: 26rpx;
  color: #333;
}

/* 底部 */
.footer {
  padding: 40rpx 0;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #999;
}

/* 赞赏弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 30rpx;
}

.qr-placeholder {
  width: 100%;
  height: 400rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.qr-hint {
  font-size: 26rpx;
  color: #999;
}

.modal-close {
  background: #b7472a;
  color: #fff;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}
