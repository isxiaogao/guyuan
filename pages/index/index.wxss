/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 500rpx;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
}
.banner-image {
  width: 100%;
  height: 100%;
}
.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}
.banner-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

/* 通用区块 */
.section {
  padding: 30rpx 24rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.section-more {
  font-size: 24rpx;
  color: #999;
}

/* 分类 */
.category-scroll {
  width: 100%;
  white-space: nowrap;
}
.category-list {
  display: inline-flex;
  padding-bottom: 10rpx;
}
.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  min-width: 120rpx;
}
.category-item:last-child {
  margin-right: 0;
}
.category-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #f5e6d8, #e8d5c4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.category-icon {
  width: 56rpx;
  height: 56rpx;
}
.category-name {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-card {
  width: 340rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 340rpx;
}
.product-image {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
}
.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: #c08463;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.product-info {
  padding: 16rpx 20rpx 20rpx;
}
.product-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
.product-price {
  display: flex;
  align-items: baseline;
}
.price-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #c08463;
}
.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 底部 */
.footer {
  padding: 60rpx 0 40rpx;
  text-align: center;
}
.footer-brand {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #c08463;
  margin-bottom: 10rpx;
}
.footer-text {
  font-size: 22rpx;
  color: #999;
}
