.page {
  padding: 24rpx;
  background: #fafaf8;
  min-height: 100vh;
}

/* 新增区域 */
.add-section {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eeece8;
}

.add-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
}

.add-btn {
  background: #b7472a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 36rpx;
  border-radius: 10rpx;
  margin-left: 16rpx;
  letter-spacing: 0.5rpx;
}

.add-btn[disabled] {
  background: #d4a08a;
}

/* 列表 */
.list-section {
  background: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid #eeece8;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-left {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  color: #2c2c2c;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.item-id {
  font-size: 22rpx;
  color: #999;
}

.item-right {
  display: flex;
  gap: 16rpx;
}

.btn-edit, .btn-del {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
}

.btn-edit {
  background: #f5f2ee;
  color: #b7472a;
}

.btn-del {
  background: #fde8e8;
  color: #c0392b;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}

.modal-btn-cancel {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #f5f2ee;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.modal-btn-confirm {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #b7472a;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
