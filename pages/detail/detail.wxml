<!-- 混合媒体轮播：图片 + 视频 -->
<swiper
  class="detail-swiper"
  indicator-dots="{{mediaList.length > 1}}"
  indicator-color="rgba(255,255,255,0.5)"
  indicator-active-color="#fff"
  bindchange="onSwiperChange"
  circular="{{true}}"
>
  <swiper-item wx:for="{{mediaList}}" wx:key="index">
    <!-- 图片 -->
    <image
      wx:if="{{item.type === 'image'}}"
      class="detail-image"
      src="{{item.url}}"
      mode="aspectFill"
      bindtap="onPreviewImage"
      data-index="{{index}}"
    />
    <!-- 视频 -->
    <view wx:else class="detail-video-wrap">
      <video
        class="detail-video"
        id="detailVideo"
        src="{{item.url}}"
        autoplay="{{currentMediaIndex === index}}"
        controls="{{true}}"
        object-fit="cover"
        show-center-play-btn="{{true}}"
        show-play-btn="{{true}}"
        enable-progress-gesture="{{true}}"
        bindfullscreenchange="onVideoFullScreenChange"
      />
    </view>
  </swiper-item>
</swiper>

<view class="detail-content" wx:if="{{product}}">
  <!-- 商品名称 -->
  <view class="title-section">
    <text class="product-title">{{product.name}}</text>
  </view>

  <!-- 商品描述 -->
  <view class="desc-section">
    <text class="product-desc">{{product.description}}</text>
  </view>

  <!-- 商品参数 -->
  <view class="params-section">
    <view class="section-title-line">
      <text class="params-title">商品参数</text>
    </view>
    <view class="params-row" wx:if="{{product.size}}">
      <text class="params-label">尺码：</text>
      <text class="params-value">{{product.size}}</text>
    </view>
    <view class="params-row" wx:if="{{product.color}}">
      <text class="params-label">颜色：</text>
      <text class="params-value">{{product.color}}</text>
    </view>
    <view class="params-row" wx:if="{{product.fabric}}">
      <text class="params-label">面料：</text>
      <text class="params-value">{{product.fabric}}</text>
    </view>
  </view>

  <!-- 占位，避免被底部按钮遮挡 -->
  <view class="bottom-placeholder"></view>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <view class="bar-btn bar-btn-delete" wx:if="{{isAdmin}}" bindtap="onDeleteTap">
    <text class="bar-btn-text">删除</text>
  </view>
  <view class="bar-btn bar-btn-edit" wx:if="{{isAdmin}}" bindtap="onEditTap">
    <text class="bar-btn-text">编辑</text>
  </view>
  <button class="bar-btn bar-btn-share" open-type="share">
    <text class="bar-btn-text">分享</text>
  </button>
  <view class="bar-btn bar-btn-fav" bindtap="onFavorite">
    <text class="bar-btn-text">{{isFav ? '已收藏' : '收藏'}}</text>
  </view>
</view>
