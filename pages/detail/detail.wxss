/* 详情轮播 */
.detail-swiper {
  width: 100%;
  height: 750rpx;
  background: #f4f2ef;
}
.detail-image {
  width: 100%;
  height: 100%;
}

.detail-content {
  background: #fff;
  margin-top: -16rpx;
  border-radius: 16rpx 16rpx 0 0;
  position: relative;
  z-index: 1;
}

/* 价格区 */
.price-section {
  padding: 30rpx 30rpx 0;
}
.price-row {
  display: flex;
  align-items: baseline;
}
.price-big {
  font-size: 48rpx;
  font-weight: 700;
  color: #b7472a;
  letter-spacing: -1rpx;
}
.price-original {
  font-size: 26rpx;
  color: #b0b0b0;
  text-decoration: line-through;
  margin-left: 16rpx;
}
.discount-tag {
  background: #b7472a;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

/* 标题区 */
.title-section {
  padding: 20rpx 30rpx 0;
}
.product-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c2c2c;
  line-height: 1.5;
}

/* 描述区 */
.desc-section {
  padding: 20rpx 30rpx;
}
.product-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

/* 参数区 */
.params-section {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}
.section-title-line {
  margin-bottom: 20rpx;
}
.params-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
}

.params-row {
  display: flex;
  padding: 12rpx 0;
}
.params-label {
  font-size: 26rpx;
  color: #999;
  min-width: 120rpx;
}
.params-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.bottom-placeholder {
  height: 20rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeece8;
  z-index: 100;
}
.bar-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 10rpx;
  margin: 0 8rpx;
}
.bar-btn-edit {
  background: #f5f2ee;
}
.bar-btn-contact {
  background: #f5f2ee;
}
.bar-btn-fav {
  background: #b7472a;
}
.bar-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.bar-btn-edit .bar-btn-text,
.bar-btn-contact .bar-btn-text {
  color: #b7472a;
}
