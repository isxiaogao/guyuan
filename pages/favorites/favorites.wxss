.favorites-page {
  min-height: 100vh;
  background: #fafaf8;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 40rpx;
}
.btn-login,
.btn-go {
  background: #b7472a;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 48rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.loading-wrap {
  text-align: center;
  padding: 200rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

.product-list {
  padding: 0 24rpx;
}

.product-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eeece8;
}

.product-image-wrapper {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
  background: #f4f2ef;
}

.product-tag {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  background: #b7472a;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.product-name {
  display: block;
  font-size: 28rpx;
  color: #2c2c2c;
  font-weight: 500;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-unfav {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 6rpx;
  background: #fde8e8;
  color: #c0392b;
  font-size: 22rpx;
  font-weight: 600;
}
