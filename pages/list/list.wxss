.category-bar {
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eeece8;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eeece8;
  position: sticky;
  top: 0;
  z-index: 11;
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  padding: 0 20rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
}
.search-clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #999;
  margin-left: 12rpx;
}
.category-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 16rpx;
}
.tag-item {
  padding: 12rpx 28rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}
.tag-item.active {
  background: #b7472a;
  color: #fff;
}

/* 商品列表 */
.product-list {
  padding: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.product-card {
  width: calc((100% - 16rpx) / 2);
  background: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  border: 1rpx solid #eeece8;
  box-sizing: border-box;
}
.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 340rpx;
}
.product-image {
  width: 100%;
  height: 100%;
  background-color: #f4f2ef;
}
.product-tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  background: #b7472a;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.product-info {
  padding: 18rpx 20rpx 22rpx;
}
.product-name {
  font-size: 26rpx;
  color: #2c2c2c;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.product-price-row {
  display: flex;
  align-items: baseline;
}
.price-current {
  font-size: 34rpx;
  font-weight: 700;
  color: #b7472a;
  letter-spacing: -0.5rpx;
}
.price-original {
  font-size: 22rpx;
  color: #b0b0b0;
  text-decoration: line-through;
  margin-left: 10rpx;
}

/* 加载中 */
.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
