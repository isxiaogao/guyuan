.category-bar {
  background: #fff;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.category-tags {
  display: flex;
  padding: 0 24rpx;
  white-space: nowrap;
}
.tag-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
  white-space: nowrap;
}
.tag-item.active {
  background: #c08463;
  color: #fff;
}

/* 商品列表 */
.product-list {
  padding: 24rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-card {
  width: 340rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.product-image-wrapper {
  position: relative;
  width: 100%;
  height: 340rpx;
}
.product-image {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
}
.product-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: #c08463;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.product-info {
  padding: 16rpx 20rpx 20rpx;
}
.product-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}
.product-price-row {
  display: flex;
  align-items: baseline;
}
.price-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #c08463;
}
.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 加载中 */
.loading-wrap {
  padding: 120rpx 0;
  text-align: center;
}
.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
