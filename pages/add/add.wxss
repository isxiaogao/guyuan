.add-page {
  padding-bottom: 160rpx;
  padding-top: 20rpx;
  background: #fafaf8;
  min-height: 100vh;
}

/* ====== 表单组 ====== */
.form-group {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

/* ====== 表单项 ====== */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eeece8;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-textarea {
  flex-direction: column;
  align-items: flex-start;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  flex-shrink: 0;
}

.required {
  color: #b7472a;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c2c2c;
  text-align: right;
}

.form-input::placeholder {
  color: #999;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #2c2c2c;
}

.form-value.placeholder {
  color: #999;
}

.form-value .arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: #999;
  transform: rotate(90deg);
  transition: transform 0.2s;
}

.form-value .arrow.up {
  transform: rotate(-90deg);
}

.form-clickable {
  cursor: pointer;
}

/* ====== textarea ====== */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #2c2c2c;
  line-height: 1.5;
}

.form-textarea::placeholder {
  color: #999;
}

/* ====== 多选区块（尺码） ====== */
.checkbox-section {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eeece8;
}

.checkbox-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkbox-label {
  font-size: 28rpx;
  color: #2c2c2c;
}

.checkbox-required {
  color: #b7472a;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.checkbox-section .van-checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.checkbox-section .van-checkbox {
  flex: 0 0 auto;
}

.checkbox-item-label {
  font-size: 26rpx !important;
  color: #2c2c2c !important;
  padding-left: 8rpx !important;
}

/* ====== 媒体区块 ====== */
.media-section {
  padding: 24rpx 32rpx 32rpx;
}

.media-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.media-label {
  font-size: 28rpx;
  color: #2c2c2c;
}

.media-required {
  color: #b7472a;
  font-size: 28rpx;
  margin-left: 4rpx;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.media-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #eeece8;
}

.media-thumb {
  width: 100%;
  height: 100%;
  background: #f5f2ee;
}

.media-video-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3a3a3a, #1a1a1a);
}

.video-play-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #b7472a;
}

.media-video-badge {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.media-delete-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  z-index: 2;
}

.media-add-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #d4cfc8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #d4cfc8;
  background: #fafaf8;
}

/* ====== 提交按钮 ====== */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeece8;
  z-index: 100;
}

/* ====== 加载中 ====== */
.loading-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 300rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}