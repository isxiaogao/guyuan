.add-page {
  padding-bottom: 160rpx;
  background: #fafaf8;
  min-height: 100vh;
}

.form-section {
  padding: 24rpx;
}

.form-item {
  background: #fff;
  border-radius: 10rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #eeece8;
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-item.half {
  flex: 1;
  background: #fff;
  border-radius: 10rpx;
  padding: 24rpx;
  margin-bottom: 0;
  border: 1rpx solid #eeece8;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.picker {
  width: 100%;
}

.picker-value {
  width: 100%;
  height: 80rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.picker-value.placeholder {
  color: #999;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  border: 2rpx dashed #d4cfc8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #d4cfc8;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeece8;
}

.submit-btn {
  background: #b7472a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 10rpx;
  border: none;
  padding: 20rpx 0;
  letter-spacing: 1rpx;
}

.submit-btn[disabled] {
  background: #d4a08a;
  color: rgba(255, 255, 255, 0.7);
}
