.page {
  background: #fafaf8;
  min-height: 100vh;
}

/* ====== 模板列表 ====== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.btn-new {
  background: #b7472a;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #999;
}

.template-list {
  padding: 0 24rpx;
}
.template-card {
  background: #fff;
  border-radius: 10rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #eeece8;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2c2c;
}
.card-size {
  font-size: 24rpx;
  color: #999;
}
.card-info {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}
.card-dpi {
  color: #b7472a;
}
.card-actions {
  display: flex;
  gap: 16rpx;
}
.card-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.card-btn-print {
  background: #b7472a;
  color: #fff;
}
.card-btn-delete {
  background: #f5f2ee;
  color: #999;
}

/* ====== 表单通用 ====== */
.form-header {
  padding: 32rpx 32rpx 24rpx;
}
.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.form-card {
  padding: 0 24rpx;
}
.form-item {
  background: #fff;
  border-radius: 10rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}
.form-section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}
.form-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.form-item-half {
  flex: 1;
  background: #fff;
  border-radius: 10rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 0;
}
.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c2c2c;
  margin-bottom: 16rpx;
}
.form-input {
  width: 100%;
  height: 72rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.form-static {
  display: block;
  font-size: 28rpx;
  color: #666;
}
.picker-value {
  width: 100%;
  height: 72rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  color: #2c2c2c;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  padding: 32rpx 24rpx;
}
.form-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.form-btn-cancel {
  background: #f5f2ee;
  color: #666;
}
.form-btn-confirm {
  background: #b7472a;
  color: #fff;
}
.form-btn-confirm[disabled] {
  background: #d4a08a;
  color: rgba(255, 255, 255, 0.7);
}

/* ====== 打印页 ====== */
.print-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  min-height: 80rpx;
}
.print-info-label {
  font-size: 28rpx;
  color: #666;
  min-width: 140rpx;
}
.print-info-value {
  font-size: 28rpx;
  color: #2c2c2c;
  flex: 1;
}
.print-info-value.text-muted {
  color: #b7472a;
}
.copy-control {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.copy-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #b7472a;
  font-weight: 600;
}
.copy-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c2c2c;
  min-width: 60rpx;
  text-align: center;
}

/* ====== 编辑器 ====== */
.page-edit {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 画布 */
.canvas-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
}
.canvas-container {
  position: relative;
  background: #fff;
  border-radius: 4rpx;
}
.canvas-border {
  position: absolute;
  inset: 0;
  border: 2rpx dashed #ddd;
  border-radius: 4rpx;
  pointer-events: none;
}
.canvas-size-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 画布元素 */
.canvas-element {
  position: absolute;
  min-width: 20rpx;
  min-height: 16rpx;
  border: 2rpx solid transparent;
  border-radius: 2rpx;
  transition: border-color 0.15s;
}
.el-active {
  border-color: #b7472a !important;
}
.el-content {
  width: 100%;
  height: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.el-text-preview {
  font-size: 20rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.el-type-price .el-text-preview {
  color: #b7472a;
  font-weight: 700;
}
.el-type-barcode .el-text-preview,
.el-type-qrcode .el-text-preview {
  color: #666;
  font-size: 18rpx;
}
.el-box-preview {
  width: 100%;
  height: 100%;
  border: 2rpx solid #999;
  border-radius: 2rpx;
}
.el-line-preview {
  width: 100%;
  height: 2rpx;
  background: #999;
}

/* 元素列表 */
.element-list {
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}
.section-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.el-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid #eeece8;
}
.el-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.el-item-icon {
  width: 48rpx;
  height: 48rpx;
  background: #f5f2ee;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #b7472a;
  font-weight: 600;
}
.el-item-name {
  font-size: 26rpx;
  color: #2c2c2c;
}
.el-item-actions {
  flex-shrink: 0;
}
.el-item-btn {
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}
.el-item-btn-del {
  background: #fde8e8;
  color: #c0392b;
}

/* 添加元素栏 */
.add-element-bar {
  display: flex;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eeece8;
  gap: 0;
}
.add-el-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.add-el-icon {
  font-size: 36rpx;
  color: #b7472a;
  margin-bottom: 4rpx;
  font-weight: 600;
}
.add-el-name {
  font-size: 20rpx;
  color: #666;
}

/* 底部操作 */
.edit-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eeece8;
  z-index: 100;
}
.edit-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.edit-btn-secondary {
  background: #f5f2ee;
  color: #666;
}
.edit-btn-primary {
  background: #b7472a;
  color: #fff;
}
.edit-btn-print {
  background: #1a1a1a;
  color: #fff;
}
