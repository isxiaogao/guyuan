<!-- 商品编辑页面 -->
<view class="add-page" wx:if="{{!loading}}">
  <view class="form-section">
    <!-- 名称 -->
    <view class="form-item">
      <text class="label">商品名称</text>
      <input class="input" placeholder="请输入商品名称" value="{{name}}" bindinput="onNameInput" maxlength="100" />
    </view>

    <!-- 价格 -->
    <view class="form-row">
      <view class="form-item half">
        <text class="label">售价（元）</text>
        <input class="input" type="digit" placeholder="0.00" value="{{price}}" bindinput="onPriceInput" />
      </view>
      <view class="form-item half">
        <text class="label">原价（元）</text>
        <input class="input" type="digit" placeholder="0.00" value="{{originalPrice}}" bindinput="onOriginalPriceInput" />
      </view>
    </view>

    <!-- 衣服类型 -->
    <view class="form-item">
      <text class="label">衣服类型</text>
      <picker class="picker" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value {{categoryIndex >= 0 ? '' : 'placeholder'}}">
          {{categoryIndex >= 0 ? categoryNames[categoryIndex] : '请选择类型'}}
        </view>
      </picker>
    </view>

    <!-- 码数 -->
    <view class="form-item">
      <text class="label">尺码</text>
      <picker class="picker" range="{{sizeOptions}}" value="{{sizeIndex}}" bindchange="onSizeChange">
        <view class="picker-value {{sizeIndex >= 0 ? '' : 'placeholder'}}">
          {{sizeIndex >= 0 ? sizeOptions[sizeIndex] : '请选择尺码'}}
        </view>
      </picker>
    </view>

    <!-- 颜色 -->
    <view class="form-item">
      <text class="label">颜色</text>
      <input class="input" placeholder="如 黑色/白色/红色" value="{{color}}" bindinput="onColorInput" />
    </view>

    <!-- 商品标签 -->
    <view class="form-item">
      <text class="label">商品标签</text>
      <picker class="picker" range="{{tagOptions}}" value="{{tagIndex}}" bindchange="onTagChange">
        <view class="picker-value {{tagIndex >= 0 ? '' : 'placeholder'}}">
          {{tagIndex >= 0 ? tagOptions[tagIndex] : '请选择标签（非必填）'}}
        </view>
      </picker>
    </view>

    <!-- 面料 -->
    <view class="form-item">
      <text class="label">面料</text>
      <input class="input" placeholder="如 100%聚酯纤维/雪纺/棉" value="{{fabric}}" bindinput="onFabricInput" />
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <text class="label">商品描述</text>
      <textarea class="textarea" placeholder="请输入商品描述" value="{{description}}" bindinput="onDescInput" maxlength="500" />
      <text class="char-count">{{description.length}}/500</text>
    </view>

    <!-- 图片上传 -->
    <view class="form-item">
      <text class="label">商品图片</text>
      <view class="image-grid">
        <view class="image-item" wx:for="{{images}}" wx:key="*this">
          <image class="image-preview" src="{{item}}" mode="aspectFill" />
          <view class="image-delete" bindtap="onDeleteImage" data-index="{{index}}">×</view>
        </view>
        <view class="image-add" bindtap="onChooseImage" wx:if="{{images.length < 9}}">
          <text class="add-icon">+</text>
          <text class="add-text">添加图片</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">保存修改</button>
  </view>
</view>

<!-- 加载中 -->
<view class="add-page" wx:if="{{loading}}">
  <view class="loading-wrapper">
    <text class="loading-text">加载中...</text>
  </view>
</view>
